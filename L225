class MyStack 
{
    private Queue<Integer> queue;
    public MyStack() 
    {
        queue = new LinkedList<>();
    }
    public void push(int x) 
    {
        int size = queue.size();
        queue.add(x);
        for (int i = 0; i < size; i++)  queue.add(queue.remove());
        
    }
    public int pop() 
    {
        return queue.remove(); 
    }
    public int top() 
    {
        return queue.peek(); 
    }

    public boolean empty() {
        return queue.isEmpty();
    }
}
